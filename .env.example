# SessionVault environment configuration
# Copy this file to .env before starting the lab.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=SessionVault
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sessionvault
DB_USERNAME=sessionvault
DB_PASSWORD=sessionvault

# -----------------------------------------------------------------------------
# Lab mode
#   vulnerable (default): all intentionally vulnerable scenarios are enabled
#   secure: secure reference implementations are enabled
# -----------------------------------------------------------------------------
LAB_MODE=vulnerable

# -----------------------------------------------------------------------------
# Individual vulnerability toggles
# Set to true to enable a vulnerable behavior, false to use secure behavior.
# LAB_MODE takes precedence only when explicitly set to "secure".
# -----------------------------------------------------------------------------
VULN_PREDICTABLE_SESSION=true
VULN_SESSION_FIXATION=true
VULN_NO_SESSION_ROTATION=true
VULN_MISSING_HTTPONLY=true
VULN_MISSING_SECURE=true
VULN_WEAK_SAMESITE=true
VULN_LONG_SESSION=true
VULN_LOGOUT_NOT_INVALIDATE=true
VULN_SESSION_IN_URL=true
VULN_CONCURRENT_SESSIONS=true
VULN_PASSWORD_CHANGE_INVALIDATION=true
VULN_ACCOUNT_DISABLE_INVALIDATION=true

# Session lifetime in seconds. Use 300 for quick expiration testing.
LAB_SESSION_LIFETIME=86400

# -----------------------------------------------------------------------------
# Session cookie name
# -----------------------------------------------------------------------------
SESSION_COOKIE=sessionvault_session
